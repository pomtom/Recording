<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- clear inherits nothing from machine-level config. Without this, a corporate
       Azure DevOps feed is consulted for every package and times out after 100s each,
       turning a 30-second restore into a nine-minute one. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
