<Window x:Class="Recorder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomtom Recorder"
        Width="380"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1B1C1F"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="Button" x:Key="Action">
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2B2D31" />
            <Setter Property="BorderBrush" Value="#3A3D42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#35383D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#232529" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#B33A3A" />
            <Setter Property="BorderBrush" Value="#C74A4A" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">

        <!-- Status -->
        <Border CornerRadius="8" Background="#232529" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#5C6066" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               Margin="8,0,0,0"
                               Foreground="#F2F2F2"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ElapsedText"
                               Text=""
                               Margin="10,0,0,0"
                               Foreground="#C9CDD2"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="14"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="DetailText"
                           Style="{StaticResource Caption}"
                           Margin="18,6,0,0"
                           TextWrapping="Wrap"
                           Text="" />
            </StackPanel>
        </Border>

        <!-- Controls -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource Primary}" Content="Start" />
            <Button x:Name="PauseButton" Grid.Column="2" Style="{StaticResource Action}" Content="Pause" />
            <Button x:Name="StopButton"  Grid.Column="4" Style="{StaticResource Action}" Content="Stop" />
        </Grid>

        <!-- Microphone mute (only meaningful while recording) -->
        <Button x:Name="MuteMicButton"
                Margin="0,0,0,10"
                Style="{StaticResource Action}"
                Content="🎤  Mute mic"
                IsEnabled="False" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SettingsButton" Grid.Column="0" Style="{StaticResource Action}" Content="Settings" />
            <Button x:Name="FolderButton"   Grid.Column="2" Style="{StaticResource Action}" Content="Open folder" />
            <Button x:Name="ExitButton"     Grid.Column="4" Style="{StaticResource Action}" Content="Exit" />
        </Grid>

        <!-- Footer -->
        <Border Margin="0,14,0,0" Padding="0,10,0,0" BorderBrush="#2E3136" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="HotkeyText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <TextBlock x:Name="OutputText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Closing this window keeps the recorder running in the system tray." />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
