<Window x:Class="Recorder.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1B1C1F"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#70757A" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#232529" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#3A3D42" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E3E5E8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="Button" x:Key="Action">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2B2D31" />
            <Setter Property="BorderBrush" Value="#3A3D42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#35383D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">

        <TextBlock Text="Capture" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="13"
                   FontWeight="SemiBold" Margin="0,0,0,10" />

        <TextBlock Text="Monitor" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="MonitorCombo" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ResolutionCombo" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="FpsCombo" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Countdown" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="CountdownCombo" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="CursorCheck" Content="Include the mouse cursor" />
        <CheckBox x:Name="SystemAudioCheck" Content="Record system audio" />
        <CheckBox x:Name="MicrophoneCheck" Content="Record microphone" />

        <TextBlock Text="Save location" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="13"
                   FontWeight="SemiBold" Margin="0,10,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Grid.Column="0" />
            <Button x:Name="BrowseButton" Grid.Column="2" Style="{StaticResource Action}" Content="Browse…" MinWidth="76" />
        </Grid>
        <TextBlock x:Name="FolderHint" Style="{StaticResource Hint}" />

        <TextBlock Text="Hotkeys" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="13"
                   FontWeight="SemiBold" Margin="0,14,0,10" />

        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Start" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="StartHotkeyBox" IsReadOnly="True" Cursor="Hand" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Pause / resume" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PauseHotkeyBox" IsReadOnly="True" Cursor="Hand" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Stop" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="StopHotkeyBox" IsReadOnly="True" Cursor="Hand" />
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Click a box and press the combination you want. A modifier (Ctrl, Alt, Shift or Win) is required. Press Esc to cancel." />

        <TextBlock x:Name="ErrorText" Foreground="#E88A8A" FontFamily="Segoe UI" FontSize="11"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource Action}" Content="Cancel" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Style="{StaticResource Action}" Content="Save" />
        </StackPanel>
    </StackPanel>
</Window>
